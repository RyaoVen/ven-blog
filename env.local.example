# 本地开发环境变量模板：cp env.local.example .env.local 后按本机情况修改
# .env.local 已被 gitignore，真实密码不会进仓库

# 必填：MySQL 连接（库不存在时启动会自动建库建表）
BLOG_MYSQL_DSN="root:你的MySQL密码@tcp(127.0.0.1:3306)/ven_blog?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci"

# 可选：种子 author 账号（首次启动用户表为空时写入）
# BLOG_AUTHOR_NAME=author
# BLOG_AUTHOR_PASSWORD=author123

# 可选：生产必须改的内部令牌（Go 与 Node 两侧需一致）
# VEN_INTERNAL_TOKEN=development-token
