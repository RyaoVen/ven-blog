# VenDevFlow 配置模板 —— 复制为同目录 devflow.env 并填写（devflow.env 已被 gitignore，严禁入库）
# 令牌入口: https://gitcode.com/setting/token-classic （选"经典令牌"，新版 JWT 令牌不能直接调 API）

GITCODE_API=https://api.gitcode.com/api/v5
GITCODE_OWNER=your-org-or-username
GITCODE_REPO=VenWarehouse
GITCODE_TOKEN=your-classic-pat

GITCODE_MAIN=main
# 默认评审人（带教者）用户名，多个英文逗号分隔；建 PR 时提示指派
GITCODE_REVIEWERS=mentor-username
